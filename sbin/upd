#!/bin/bash

DEBUG_MODE=false; if $DEBUG_MODE ; then echo "DEBUG EXECUTING $0 line ${LINENO}" ; fi

# Include script setup file
	source script-setup
	if [ ! $FUNCTIONS_ARE_DEFINED ]; then echo $0: Functions not defined. Aborting; logger $0: Functions not defined. Aborting; exit 1; fi
	if [ ! $VARIABLES_ARE_DEFINED ]; then echo $0: Variables not defined. Aborting; logger $0: Variables not defined. Aborting; exit 1; fi

# Require root
	f_require_root

#####################################################################################################
# DOWNLOAD THE ubuntu-tools REPOSTORY
#####################################################################################################

	echo "$0: Downloading the ubuntu-tools repository to $REPO_DIR."

	rm -fr "$REPO_DIR"
  curl -L -s -o "$REPO_DIR.zip" \
  	-O https://github.com/lhensley/ubuntu-tools/archive/master.zip
  unzip -q -d "$REPO_PARENT" "$REPO_DIR.zip"
  mv "$REPO_DIR-master" "$REPO_DIR"
  rm "$REPO_DIR.zip"


#####################################################################################################
# INITIALIZING AND POPULATING $SBIN_DIR
#####################################################################################################

	echo "$0: Initializing and populating $SBIN_DIR."

	mkdir -p "$SBIN_DIR"              # Make $SBIN_DIR
	chmod 755 "$SBIN_DIR"             # Set permissions
	rm -rf "$SBIN_DIR"/*              # Make sure this directory are empty.
	cp -r "$REPO_DIR/sbin" "$SBIN_PARENT/"


#####################################################################################################
# APPLYING CONFIGURATIONS AND PERMISSIONS
#####################################################################################################

	echo "$0: Applying configurations and permissions."
	_apply-configs
	_apply-permissions


#####################################################################################################
# UPDATING LOCAL APT PACKAGES
#####################################################################################################

	echo "$0: Updating local apt packages"
	f_upd
	echo


#####################################################################################################
# DROP THIS PART
#####################################################################################################

	echo "$0: IMPORTANT: To update from github, run:"
	echo "  sudo git-updates"
 	

#####################################################################################################
# FOOTER
#####################################################################################################

	f_debug_variable "script_footer" "${PATHNAME[script_footer]}"
	source "${PATHNAME[script_footer]}"


