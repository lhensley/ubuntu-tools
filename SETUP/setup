#   INSTRUCTIONS FOR THE MANUAL PART OF THE INSTALLATION
# 	    Go to https://192.168.168.8:943/admin 
#	        Ignore browser security warnings, 
#               and login with username "openvpn" 
#               and the password in /home/lhensley/.openvpn_as_password 
#           Ignore the "Get Activation Key" button.
#		Under Configuration / Network Settings,
#			In section "VPN Server"
#				Change "Hostname or IP Address" to vpn.lanehensley.org
#				Change Protocol to udp
#				Change port number near the bottom to 1194
#				Press the "Save Settings" button at the bottom of the page.
#				Press the "Update Running Server" button at the top of the page.
#		Under User Management / User Permissions, 
#			Select user openvpn, click on More Settings, 
#               and change the local password to the one in 1Password under OpenVPN Access Server.
#			Create user lhensley (NOT an Admin).
#				Click on "Allow Auto-login" for lhensley.
#				Click on More Settings, 
#                   and change the local password to the one in 1Password 
#                   under OpenVPN Client (lhensley). 
#				Press the "Save Settings" button at the bottom of the page.
#				Press the "Update Running Server" button at the top of the page.
#		Under User Management / User Profiles,
#			Choose "+ New Profile" for user lhensley. 
#			In the pop-up window, select "Autologin" and "tls-crypt v2".
#			Click "+ Create Profile". It will download a file to your computer.
#		Use your existing activation key if possible. (Install on pd1 ONLY and not dsm1.) 
#           Otherwise, follow the prompts to get and install a new activation key. 
#       Logout
#####################################################################################################

echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
    "Installing OpenVPN Access Server." | tee -a "$DETAIL_LOG"

#====================================================================================================
# WARNING: I THINK THIS CODE DOESN'T WORK. NEED TO VERIFY. 23 Nov 2026
#====================================================================================================

if [ $HOSTNAME == "dsm1" ]; then
    INSTALL_DIR="/tmp/.openvpn" &>> $DETAIL_LOG
    rm -rf "$INSTALL_DIR" &>> $DETAIL_LOG
    mkdir -p "$INSTALL_DIR" &>> $DETAIL_LOG
    cd "$INSTALL_DIR" &>> $DETAIL_LOG
    rm -f ./install.sh &>> $DETAIL_LOG
    wget https://packages.openvpn.net/as/install.sh &>> $DETAIL_LOG
    chmod 700 ./install.sh &>> $DETAIL_LOG
    systemctl stop openvpn* &>> $DETAIL_LOG
    systemctl disable openvpn* &>> "$DETAIL_LOG"
    rm -rf /usr/local/openvpn_as &>> $DETAIL_LOG
    apt-get -y purge openvpn*  &>> "$DETAIL_LOG"
    apt-get -y autoremove  &>> "$DETAIL_LOG"

    echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
        "Executing ./install.sh" | tee -a "$DETAIL_LOG"
      bash ./install.sh --yes | tee -a "$DETAIL_LOG"
    echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
        "End ./install.sh; continuing installing OpenVPN Access Server." | tee -a "$DETAIL_LOG"

    rm -f ./install.sh &>> $DETAIL_LOG
    systemctl enable openvpnas --no-pager &>> $DETAIL_LOG
    cat /usr/local/openvpn_as/init.log | grep "To login please use" &>> ./password_temp
    grep -oP 'account with "\K.*?(?=\" password)' ./password_temp \
        &>> $ADMIN_DIR/.openvpn_as_password &>> $DETAIL_LOG
    rm ./password_temp &>> $DETAIL_LOG
    chmod 600 $ADMIN_DIR/.openvpn_as_password &>> $DETAIL_LOG
    chown $ADMIN_USER:$ADMIN_USER $ADMIN_DIR/.openvpn_as_password &>> $DETAIL_LOG
    fi

f_record_to_installation_log "installed OpenVPN Access Server"


