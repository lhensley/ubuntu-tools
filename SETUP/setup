#!/bin/bash
# setup2026
# Updated 12 Nov 2026


#####################################################################################################
# INSTRUCTIONS
#####################################################################################################

# Copy this file to the ~ directory and set its permissions for 700.
# Edit the file to adjust the VARIABLES definitions below.
# To start the Execute this file with this command:
#   sudo ~/setup


#####################################################################################################
# VARIABLES
#####################################################################################################

echo "$0: Defining variables."

my_full_name="Lane Hensley"
my_email="lane@lanehensley.org"
ADMIN_DIR="/home/lhensley"
ADMIN_HOME_DIR="$ADMIN_DIR"
ROOT_USER="root"
ROOT_HOME_DIR="/root"
SBIN_DIR="/usr/local/sbin"
SBIN_PARENT="$(dirname $SBIN_DIR)"
REPO_DIR="/var/local/ubuntu-tools"
REPO_PARENT="$(dirname $REPO_DIR)"

COPY_LIFEBOAT=true
LIFEBOAT_MOUNT_POINT=/mnt/4TBA
LIFEBOAT_DRIVE_UUID=41102e3a-dac6-45b4-9a5b-20816b7530ea

INSTALL_LOG="$ADMIN_DIR/installation_log.txt"
# Possible values for TIMEZONE: 
# "America/Honolulu" "America/Anchorage" "America/Los_Angeles" "America/Phoenix" 
# "America/Denver" "America/Chicago" "America/New_York"
TIMEZONE="America/Chicago"


#####################################################################################################
# FUNCTIONS
#####################################################################################################

echo "$0: Defining functions."

function f_dirname () {
    # returns directory of a full path and/or file
    # Usage f_dirname "PATH_AND_OR_FILE"
	# See also f_file_ext, f_file_main, and f_replace_ext
    dirname "$1"
    }    

function f_is_file {
	# Usage: if $(f_is_file "file_or_path_name"); then commands_if_true; else commands_if_false; fi
	# $1 = "$string_to_check"
    if [ -f "$1" ]; then echo true; else echo false; fi
	}

function f_pause () {
    read -s -n 1 -p "Press any key to continue . . .\n"
}

function f_record_to_installation_log () {
    # records a log entry in $INSTALL_LOG
    # Usage f_record_to_installation_log $message
    echo "$(date)   $1" >> $INSTALL_LOG
    }
    

#####################################################################################################
# CHECK FOR SUDO
#####################################################################################################

echo "sudo ~/setupChecking that we're root or sudo."

if [[ $EUID -ne 0 ]]; then
    echo ""
    echo "$0: Use sudo. $0 must be run as root." 1>&2
    echo "  *** ABORTED ***" 1>&2
    exit 1
    fi


#####################################################################################################
# CHECK FOR REQUIRED FILES
#####################################################################################################

echo "$0: Checking that all required files are present."

ABORT=false

# EXAMPLE:
# if ! $(f_is_file $ADMIN_DIR/'Contents of gitconfig.txt') ; then
#     set ABORT=true
#     echo $0: \'$ADMIN_DIR/Contents of gitconfig.txt\' is REQUIRED.
#     fi

if $ABORT ; then
    echo "$0: ABORTED." 1>&2
    exit 1
    fi


#####################################################################################################
# SET TIMEZONE
#####################################################################################################

echo "Setting time zone."

echo "" >> $INSTALL_LOG
echo "" >> $INSTALL_LOG
f_record_to_installation_log "Begin execution of $0"
timedatectl set-timezone $TIMEZONE
f_record_to_installation_log "Time zone set to $TIMEZONE"


#####################################################################################################
# SAVE THE ORIGINAL / AND /boot FILE SYSTEMS. 2024-07-07
#####################################################################################################

    echo "$0: Saving the original /etc/fstab."

	cp --update /etc/fstab /etc/fstab.original.install


#####################################################################################################
# INSTALL universe REPOSITORY AND UPGRADES
#####################################################################################################

echo "$0: Installing universe repository and apt packages updated."

add-apt-repository universe --yes
apt --yes clean
apt update && apt --yes dist-upgrade
apt --yes autoremove
f_record_to_installation_log "universe repository installed and apt packages updated"


#####################################################################################################
# INSTALL BASIC UTILITIES
#####################################################################################################

echo "$0: Installing universe repository and apt packages updated."

# Not used currently: git git-doc
sudo apt --yes install at certbot curl debconf-utils fail2ban \
    fwupd moreutils libssl-dev openssl ufw unzip

f_record_to_installation_log "universe repository installed and apt packages updated"


#####################################################################################################
# CREATE MOUNT POINTS FOR EXTERNAL STORAGE
#####################################################################################################

echo "$0: Creating mount points for external storage."

if [ $HOSTNAME == "dsm1" ]; then
    sudo mkdir -p /mnt/2TBA /mnt/3TBB /mnt/4TBA /mnt/5TBC /mnt/5TBD /mnt/5TBE /mnt/12TBA /mnt/12TBB \
        /mnt/12TBC /mnt/20TBA /mnt/Black1TB /mnt/Silver1TB /mnt/Silver5TB-A /mnt/Silver5TB-B
    sudo chmod 700 /mnt/*
    fi

if [ $HOSTNAME == "pd1" ]; then
    sudo mkdir -p /mnt/bob
    sudo chmod 700 /mnt/*
    fi

f_record_to_installation_log "mount points created for external storage"


#####################################################################################################
# COPY THE LIFEBOAT TO HOME DIRECTORY FOR dsm1 ONLY
#####################################################################################################

if $COPY_LIFEBOAT ; then
  if [ $HOSTNAME == "dsm1" ]; then
    mkdir -p $LIFEBOAT_MOUNT_POINT; sudo mount -U $LIFEBOAT_DRIVE_UUID -t ext4 $LIFEBOAT_MOUNT_POINT
    echo "$0: Copying content into ~/lifeboat."
    # rsync
      # -a = archive mode is -rlptgoD (no -A,-X,-U,-N,-H)
      # -E = preserve executability
      # --info-progress2 = outputs overall transfer statistics for the entire job
      # -v = verbose, which we've not used
      rsync -aE --info=progress2 --delete $LIFEBOAT_MOUNT_POINT/lifeboat $ADMIN_DIR/
      chmod 700 $ADMIN_DIR/lifeboat   # Owned by root, permissions only to root
      fi
    fi

f_record_to_installation_log "queued copying lifeboat to ~/lifeboat"


#####################################################################################################
# DOWNLOAD THE ubuntu-tools REPOSTORY
#####################################################################################################

echo "$0: Downloading the ubuntu-tools repository to $REPO_DIR."

rm -fr "$REPO_DIR"
curl -L -s -o "$REPO_DIR.zip" \
  -O https://github.com/lhensley/ubuntu-tools/archive/master.zip
unzip -q -d "$REPO_PARENT" "$REPO_DIR.zip"
mv "$REPO_DIR-master" "$REPO_DIR"
rm "$REPO_DIR.zip"

f_record_to_installation_log "downloaded the ubuntu-tools repository"


#####################################################################################################
# INITIALIZING AND POPULATING $SBIN_DIR
#####################################################################################################

echo "$0: Initializing and populating $SBIN_DIR."

mkdir -p "$SBIN_DIR"              # Make $SBIN_DIR
chmod 755 "$SBIN_DIR"             # Set permissions
rm -rf "$SBIN_DIR"/*              # Make sure this directory are empty.
cp -r "$REPO_DIR/sbin" "$SBIN_PARENT/"

f_record_to_installation_log "initialized and populating $SBIN_DIR"


#####################################################################################################
# RELOADING DAEMONS
# Unclear what purpose this serves. Disabled 10/07/2026 pending need for this.
#####################################################################################################

# echo "$0: Reloading systemd manager configuration"

# systemctl daemon-reload   # Line 69 in setup-pre-2026

# f_record_to_installation_log "reloaded systemd manager configuration"


#####################################################################################################
# GET A $TIMESTAMP
# Unclear what purpose this serves. Disabled 10/07/2026 pending need for this.
#####################################################################################################

# echo "$0: Getting a timestamp"

# TIMESTAMP=$(/bin/date '+%Y-%m-%d-%H-%M-%S-%Z')   # Line 77 in setup-pre-2026

# f_record_to_installation_log "got a timestamp"


#####################################################################################################
# ENTER NON-INTERACTIVE MODE
#####################################################################################################

echo "$0: Turn on non-interactive mode"

# Unclear what purpose this serves. 
export DEBIAN_FRONTEND=noninteractive   # Line 94 in setup-pre-2026

f_record_to_installation_log "turned on non-interactive mode"


#####################################################################################################
# INCLUDE SCRIPT SETUP FILE
#####################################################################################################

source script-setup
if [ ! $FUNCTIONS_ARE_DEFINED ]; then echo $0: Functions not defined. Aborting; logger $0: Functions not defined. Aborting; exit 1; fi
if [ ! $VARIABLES_ARE_DEFINED ]; then echo $0: Variables not defined. Aborting; logger $0: Variables not defined. Aborting; exit 1; fi







### Good from set-pre-2026 line 182








#####################################################################################################
# END
#####################################################################################################

echo "Done." 1>&2
echo "" 1>&2
echo "You may want to delete file $0 ." 1>&2

f_record_to_installation_log "$0 done"

exit 0
