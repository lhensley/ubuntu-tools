function f_dirname () {
    # returns directory of a full path and/or file
    # Usage f_dirname "PATH_AND_OR_FILE"
	# See also f_file_ext, f_file_main, and f_replace_ext
    dirname "$1"
    }    

function f_is_file {
	# Usage: if $(f_is_file "file_or_path_name"); then commands_if_true; else commands_if_false; fi
	# $1 = "$string_to_check"
    if [ -f "$1" ]; then echo true; else echo false; fi
	}

function f_pause () {
    read -s -n 1 -p "Press any key to continue . . .\n"
    }

function f_record_to_installation_log () {
    # records a log entry in $INSTALL_LOG
    # Usage f_record_to_installation_log $message
    echo "$(date)   $1" | tee -a "$DETAIL_LOG" &>> $INSTALL_LOG
    }


#####################################################################################################
# CHANGING DIRECTORY TO ~
#####################################################################################################

echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
    "Changing directory to ~" | tee -a "$DETAIL_LOG"

cd ~/


#####################################################################################################
# CHECK FOR SUDO
#####################################################################################################

echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
    "Checking that you're root or sudo." | tee -a "$DETAIL_LOG"

if [[ $EUID -ne 0 ]]; then
    echo "" | tee -a "$DETAIL_LOG"
    echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
        "\e[1;31mUse sudo. $0 must be run as root.\n\033[0m" | tee -a "$DETAIL_LOG"
    echo "\e[1;31m  *** ABORTED ***\n\033[0m" | tee -a "$DETAIL_LOG"
    exit 1
    fi


#####################################################################################################
# CHECK FOR REQUIRED FILES
#####################################################################################################

