    "Copying the lifeboat to home directory for dsm1 only." | tee -a "$DETAIL_LOG"

if $COPY_LIFEBOAT ; then
  if [ $HOSTNAME == "dsm1" ]; then
    mkdir -p $LIFEBOAT_MOUNT_POINT &>> $DETAIL_LOG
    mount -a -U $LIFEBOAT_DRIVE_UUID -t ext4 $LIFEBOAT_MOUNT_POINT &>> $DETAIL_LOG
    echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
        "Copying content into ~/lifeboat." | tee -a "$DETAIL_LOG"
      # rsync
      # -a = archive mode is -rlptgoD (no -A,-X,-U,-N,-H)
      # -E = preserve executability
      # --info-progress2 = outputs overall transfer statistics for the entire job
      # -v = verbose, which we've not used
      rsync -aE --delete $LIFEBOAT_MOUNT_POINT/lifeboat $ADMIN_DIR/
      chmod 700 $ADMIN_DIR/lifeboat   # Owned by root, permissions only to root
      fi
    ln /home/lhensley/lifeboat/var/spool/cron/crontabs/* /home/lhensley/lifeboat/backups/ \
        &>> $DETAIL_LOG
    ln /home/lhensley/lifeboat/etc/aliases* /home/lhensley/lifeboat/backups/ &>> $DETAIL_LOG
    fi

f_record_to_installation_log "queued copying lifeboat to ~/lifeboat"


#####################################################################################################
# DOWNLOAD THE ubuntu-tools REPOSITORY
#####################################################################################################

