    "Installing certbot and LetsEncrypt." | tee -a "$DETAIL_LOG"

# Purge any existing installations of certbot
command -v apt &>> "$DETAIL_LOG" && dpkg -s certbot &>> "$DETAIL_LOG" && \
    apt-get --yes remove certbot &>> "$DETAIL_LOG"
command -v dnf &>> "$DETAIL_LOG" && dnf --yes remove certbot
command -v yum &>> "$DETAIL_LOG" && yum --yes remove certbot

# Install certbot
#if ! snap info certbot &>> "$DETAIL_LOG" ; then 
  snap install --classic certbot &>> $DETAIL_LOG
  ln -s /snap/bin/certbot /usr/bin/certbot &>> $DETAIL_LOG
#  fi
# Create the certificates
certbot certonly --apache --no-redirect -d lanehensley.org &>> $DETAIL_LOG
certbot certonly --apache --no-redirect -d files.lanehensley.org &>> $DETAIL_LOG
certbot certonly --apache --no-redirect -d dsm1.lanehensley.org &>> $DETAIL_LOG
