# Copy this file to the ~ directory and set its permissions for 700.
# Edit the file to adjust the VARIABLES definitions below.
# When changes are To start the Execute this file with this command:
#       

#####################################################################################################
# VARIABLES
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"): Defining variables."

# EXTREMELY IMPORTANT:
# Do NOT define the Security Variables on the version in repository! MAJOR security problem
# Instead, copy this to the server, define 

# Security Variables
MYSQL_ADMIN_PWD="-fVji8AV2NP_wYsED4-HWUwYbb7Ls-" # Found in 1Password
MYSQL_LHENSLEY_PWD="Hi3B9bbazZrF2aBD8WshWbf*9GYf*2" # Found in 1Password

# true causes script pathname, line number, and date
# false causes markers to be silenced
MARKERS=true

my_full_name="Lane Hensley"
my_email="lane@lanehensley.org"
DOMAIN_NAME="lanehensley.org"
ADMIN_DIR="/home/lhensley"
ADMIN_HOME_DIR="$ADMIN_DIR"
ROOT_USER="root"
ROOT_HOME_DIR="/root"
SBIN_DIR="/usr/local/sbin"
SBIN_PARENT="$(dirname $SBIN_DIR)"
REPO_DIR="/var/local/ubuntu-tools"
REPO_PARENT="$(dirname $REPO_DIR)"

COPY_LIFEBOAT=true
LIFEBOAT_MOUNT_POINT=/mnt/4TBA
LIFEBOAT_DRIVE_UUID=41102e3a-dac6-45b4-9a5b-20816b7530ea

INSTALL_LOG="$ADMIN_DIR/installation.log"

# Possible values for TIMEZONE: 
# "America/Honolulu" "America/Anchorage" "America/Los_Angeles" "America/Phoenix" 
# "America/Denver" "America/Chicago" "America/New_York"
TIMEZONE="America/Chicago"


#####################################################################################################
# FUNCTIONS
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"): Defining functions."

function f_dirname () {
    # returns directory of a full path and/or file
    # Usage f_dirname "PATH_AND_OR_FILE"
	# See also f_file_ext, f_file_main, and f_replace_ext
    dirname "$1"
    }    

function f_is_file {
	# Usage: if $(f_is_file "file_or_path_name"); then commands_if_true; else commands_if_false; fi
	# $1 = "$string_to_check"
    if [ -f "$1" ]; then echo true; else echo false; fi
	}

function f_pause () {
    read -s -n 1 -p "Press any key to continue . . .\n"
    }

function f_record_to_installation_log () {
    # records a log entry in $INSTALL_LOG
    # Usage f_record_to_installation_log $message
    echo "$(date)   $1" >> $INSTALL_LOG
    }


#####################################################################################################
# CHECK FOR SUDO
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"): Checking that you're root or sudo."

if [[ $EUID -ne 0 ]]; then
    echo ""
    echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Use sudo. $0 must be run as root." 1>&2
    echo "  *** ABORTED ***" 1>&2
    exit 1
    fi


#####################################################################################################
# CHECK FOR REQUIRED FILES
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"): Checking that all required files are present."

ABORT=false

# EXAMPLE:
# if ! $(f_is_file $ADMIN_DIR/'Contents of gitconfig.txt') ; then
#     set ABORT=true
#     echo $0: \'$ADMIN_DIR/Contents of gitconfig.txt\' is REQUIRED.
#     fi

if $ABORT ; then
    echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "ABORTED." 1>&2
    exit 1
    fi


#####################################################################################################
# SET TIMEZONE
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"): Setting time zone."

echo "" >> $INSTALL_LOG
echo "" >> $INSTALL_LOG
f_record_to_installation_log "Begin execution of $0"
ln -fs /usr/share/zoneinfo/"$TIMEZONE" /etc/localtime
timedatectl set-timezone $TIMEZONE
f_record_to_installation_log "Time zone set to $TIMEZONE"


#####################################################################################################
# SAVE THE ORIGINAL / AND /boot FILE SYSTEMS. 2024-07-07
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Saving the original /etc/fstab."

cp --update /etc/fstab /etc/fstab.original.install


#####################################################################################################
# ENTER NON-INTERACTIVE MODE
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Turning on non-interactive mode for installing applications."

export DEBIAN_FRONTEND=noninteractive

f_record_to_installation_log "turned on non-interactive mode for installing applications"


#####################################################################################################
# INSTALL universe REPOSITORY AND UPGRADES
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing universe repository and apt packages updated."

add-apt-repository universe --yes
apt --yes clean
apt update && apt --yes dist-upgrade
apt --yes autoremove
f_record_to_installation_log "universe repository installed and apt packages updated"


#####################################################################################################
# INSTALL BASIC UTILITIES
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing basic utilities."

# Not used currently: git git-doc
apt --yes install apg at curl ddclient debconf-utils fail2ban \
    fwupd gpg gzip libssl-dev moreutils openssl tzdata ufw unzip uuid-runtime
# NOTES:
# As of 11/14/2026 (and earlier), the ddns service is at namecheap
# To force an update and give you diagnostic data: 
#   ddclient -daemon=0 -debug -verbose -noquiet -force

f_record_to_installation_log "installed basic utilities"


#####################################################################################################
# INSTALL MAILUTILS (INCLUDING POSTFIX)
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing mailutils (including postfix)."

yes | apt install --yes mailutils

ecord_to_installation_log "installed mailutils (including postfix)"


#####################################################################################################
# INSTALL WEBMIN
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing webmin."

wget http://www.webmin.com/download/deb/webmin-current.deb
WEBMIN_PACKAGES="openssl libcurl4-openssl-dev libssl-dev perl"
WEBMIN_PACKAGES+=" libnet-ssleay-perl libauthen-pam-perl"
WEBMIN_PACKAGES+=" libpam-runtime libio-pty-perl apt-show-versions"
WEBMIN_PACKATES+=" python libsocket6-perl libapt-pkg-perl"
apt install --yes $WEBMIN_PACKAGES
dpkg --install ./webmin-current.deb
rm -f ./webmin-current.deb

f_record_to_installation_log "installed webmin"


#####################################################################################################
# INSTALL OpenVPN Access Server
#   CRUCIAL: This is as far as we can go with CLI.
#   INSTRUCTIONS FOR THE MANUAL PART OF THE INSTALLATION
# 	    Go to https://192.168.168.8:943/admin 
#	        Ignore browser security warnings, 
#               and login with username "openvpn" 
#               and the password in /home/lhensley/.openvpn_as_password 
#           Ignore the "Get Activation Key" button.
#		Under Configuration / Network Settings,
#			In section "VPN Server"
#				Change "Hostname or IP Address" to vpn.lanehensley.org
#				Change Protocol to udp
#				Change port number near the bottom to 1194
#				Press the "Save Settings" button at the bottom of the page.
#				Press the "Update Running Server" button at the top of the page.
#		Under User Management / User Permissions, 
#			Select user openvpn, click on More Settings, 
#               and change the local password to the one in 1Password under OpenVPN Access Server.
#			Create user lhensley (NOT an Admin).
#				Click on "Allow Auto-login" for lhensley.
#				Click on More Settings, 
#                   and change the local password to the one in 1Password 
#                   under OpenVPN Client (lhensley). 
#				Press the "Save Settings" button at the bottom of the page.
#				Press the "Update Running Server" button at the top of the page.
#		Under User Management / User Profiles,
#			Choose "+ New Profile" for user lhensley. 
#			In the pop-up window, select "Autologin" and "tls-crypt v2".
#			Click "+ Create Profile". It will download a file to your computer.
#		Use your existing activation key if possible. (Install on pd1 ONLY and not dsm1.) 
#           Otherwise, follow the prompts to get and install a new activation key. 
#       Logout
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing OpenVPN Access Server."

if [ $HOSTNAME == "dsm1" ]; then
    INSTALL_DIR="/tmp/.openvpn"
    rm -rf "$INSTALL_DIR"
    mkdir -p "$INSTALL_DIR"
    cd "$INSTALL_DIR"
    rm -f ./install.sh
    wget https://packages.openvpn.net/as/install.sh
    chmod 700 ./install.sh
    systemctl stop openvpn*
    systemctl disable openvpn* 2>> /dev/null
    rm -rf /usr/local/openvpn_as
    apt -y purge openvpn*
    apt -y autoremove
    bash ./install.sh --yes
    rm -f ./install.sh
    systemctl enable openvpnas --no-pager
    cat /usr/local/openvpn_as/init.log | grep "To login please use" > ./password_temp
    grep -oP 'account with "\K.*?(?=\" password)' ./password_temp > $ADMIN_DIR/.openvpn_as_password
    rm ./password_temp
    chmod 600 $ADMIN_DIR/.openvpn_as_password
    chown $ADMIN_USER:$ADMIN_USER $ADMIN_DIR/.openvpn_as_password
    fi

f_record_to_installation_log "installed OpenVPN Access Server"


#####################################################################################################
# CREATE MOUNT POINTS FOR EXTERNAL STORAGE
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Creating mount points for external storage."

if [ $HOSTNAME == "dsm1" ]; then
    mkdir -p /mnt/2TBA /mnt/3TBB /mnt/4TBA /mnt/5TBC /mnt/5TBD /mnt/5TBE /mnt/12TBA /mnt/12TBB \
      /mnt/12TBC /mnt/20TBA /mnt/Black1TB /mnt/Silver1TB /mnt/Silver5TB-A /mnt/Silver5TB-B
    chmod 700 /mnt/*
    fi

if [ $HOSTNAME == "pd1" ]; then
    mkdir -p /mnt/bob
    chmod 700 /mnt/*
    fi

f_record_to_installation_log "mount points created for external storage"


#####################################################################################################
# COPY THE LIFEBOAT TO HOME DIRECTORY FOR dsm1 ONLY
#####################################################################################################

if $COPY_LIFEBOAT ; then
  if [ $HOSTNAME == "dsm1" ]; then
    mkdir -p $LIFEBOAT_MOUNT_POINT; mount -U $LIFEBOAT_DRIVE_UUID -t ext4 $LIFEBOAT_MOUNT_POINT
    echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Copying content into ~/lifeboat."
      # rsync
      # -a = archive mode is -rlptgoD (no -A,-X,-U,-N,-H)
      # -E = preserve executability
      # --info-progress2 = outputs overall transfer statistics for the entire job
      # -v = verbose, which we've not used
      rsync -aE --info=progress2 --delete $LIFEBOAT_MOUNT_POINT/lifeboat $ADMIN_DIR/
      chmod 700 $ADMIN_DIR/lifeboat   # Owned by root, permissions only to root
      fi
    ln /home/lhensley/lifeboat/var/spool/cron/crontabs/* /home/lhensley/lifeboat/backups/
    ln /home/lhensley/lifeboat/etc/aliases* /home/lhensley/lifeboat/backups/
    fi

f_record_to_installation_log "queued copying lifeboat to ~/lifeboat"


#####################################################################################################
# DOWNLOAD THE ubuntu-tools REPOSITORY
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Downloading the ubuntu-tools repository to $REPO_DIR."

rm -fr "$REPO_DIR"
curl -L -s -o "$REPO_DIR.zip" \
  -O https://github.com/lhensley/ubuntu-tools/archive/master.zip
unzip -q -d "$REPO_PARENT" "$REPO_DIR.zip"
mv "$REPO_DIR-master" "$REPO_DIR"
rm "$REPO_DIR.zip"

f_record_to_installation_log "downloaded the ubuntu-tools repository"


#####################################################################################################
# INITIALIZING AND POPULATING $SBIN_DIR
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Initializing and populating $SBIN_DIR."

mkdir -p "$SBIN_DIR"              # Make $SBIN_DIR
chmod 755 "$SBIN_DIR"             # Set permissions
rm -rf "$SBIN_DIR"/*              # Make sure this directory are empty.
cp -r "$REPO_DIR/sbin" "$SBIN_PARENT/"

f_record_to_installation_log "initialized and populating $SBIN_DIR"


#####################################################################################################
# RELOADING DAEMONS
# Unclear what purpose this serves. Disabled 10/07/2026 pending need for this.
#####################################################################################################

# echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Reloading systemd manager configuration"

# systemctl daemon-reload   # Line 69 in setup-pre-2026

# f_record_to_installation_log "reloaded systemd manager configuration"


#####################################################################################################
# GET A $TIMESTAMP
# Unclear what purpose this serves. Disabled 10/07/2026 pending need for this.
#####################################################################################################

# echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Getting a timestamp"

# TIMESTAMP=$(/bin/date '+%Y-%m-%d-%H-%M-%S-%Z')   # Line 77 in setup-pre-2026

# f_record_to_installation_log "got a timestamp"


#####################################################################################################
# INCLUDE SCRIPT SETUP FILE
#####################################################################################################

source script-setup
if [ ! $FUNCTIONS_ARE_DEFINED ]; then echo $0: Functions not defined. Aborting; logger $0: Functions not defined. Aborting; exit 1; fi
if [ ! $VARIABLES_ARE_DEFINED ]; then echo $0: Variables not defined. Aborting; logger $0: Variables not defined. Aborting; exit 1; fi


#####################################################################################################
# INSTALL APACHE2
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing apache2."

apt --yes install --yes apache2-doc apache2-suexec-pristine
a2enmod ssl rewrite
systemctl restart apache2

f_record_to_installation_log "installed apache2"


#####################################################################################################
# INSTALL PHP
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing php."

PHP_PACKAGES="build-essential php libapache2-mod-php"
PHP_PACKAGES+=" php-cli php-mysql php-gd"
PHP_PACKAGES+=" php-curl php-ldap libmcrypt-dev"
PHP_PACKAGES+=" php-mbstring php-dev php-pear"
PHP_PACKAGES+=" libc-client2007e mlock uw-mailutils"
apt install --yes $PHP_PACKAGES
phpenmod gd curl ldap mbstring
systemctl restart apache2

f_record_to_installation_log "installed php"


#####################################################################################################
# INSTALL CERTBOT AND LETSENCRYPT
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing certbot and LetsEncrypt."

# Purge any existing installations of certbot
command -v apt >/dev/null 2>&1 && apt --yes remove certbot
command -v dnf >/dev/null 2>&1 && dnf --yes remove certbot
command -v yum >/dev/null 2>&1 && yum --yes remove certbot
# Install certbot
if ! snap info certbot > /dev/null 2> /dev/null ; then 
  snap install --classic certbot
  ln -s /snap/bin/certbot /usr/bin/certbot
  fi
# Create the certificates
certbot certonly --apache --no-redirect -d lanehensley.org
certbot certonly --apache --no-redirect -d files.lanehensley.org
certbot certonly --apache --no-redirect -d dsm1.lanehensley.org
certbot certonly --apache --no-redirect -d pd1.lanehensley.org

f_record_to_installation_log "installed certbot and LetsEncrypt"


#####################################################################################################
# INSTALL MySQL
#####################################################################################################

echo "$0, line ${LINENO}, $(date +"%F %T.%3N %Z"):  "Installing MySQL."

# Install the package
export DEBIAN_FRONTEND=noninteractive
apt-get install --yes mysql-server
# Harden the installation
mysql -e "DELETE FROM mysql.user WHERE User='';" # Delete anonymous users
mysql -e "DELETE FROM mysql.user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');" # Ensure the root user can not log in remotely
mysql -e "DROP DATABASE IF EXISTS test; DELETE FROM mysql.db WHERE Db='test' OR Db='test\_%';" # Remove the test database
mysql -e "FLUSH PRIVILEGES;" # Flush the privileges tables
# Open the eligible client addresses
sed -i 's/127.0.0.1/0.0.0.0/g' /etc/mysql/mysql.conf.d/mysqld.cnf
# Set security
mysql -e "CREATE USER `admin`@`localhost` IDENTIFIED BY \"$MYSQL_ADMIN_PWD\"";
mysql -e "CREATE USER `admin`@`192.168.168.0/24` IDENTIFIED BY \"$MYSQL_ADMIN_PWD\"";
mysql -e "CREATE USER `admin`@`10.0.0.0/8` IDENTIFIED BY \"$MYSQL_ADMIN_PWD\"";
mysql -e "CREATE USER `lhensley`@`%` IDENTIFIED BY \"$MYSQL_LHENSLEY_PWD\"";
mysql -e "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, \
    RELOAD, SHUTDOWN, PROCESS, FILE, REFERENCES, INDEX, \
    ALTER, SHOW DATABASES, SUPER, CREATE TEMPORARY TABLES, \
    LOCK TABLES, EXECUTE, REPLICATION SLAVE, \
    REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, \
    CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, \
    TRIGGER, CREATE TABLESPACE, CREATE ROLE, \
    DROP ROLE ON *.* TO `admin`@`localhost` WITH GRANT OPTION;"
mysql -e "GRANT ALLOW_NONEXISTENT_DEFINER, \
    APPLICATION_PASSWORD_ADMIN,AUDIT_ABORT_EXEMPT, \
    AUDIT_ADMIN,AUTHENTICATION_POLICY_ADMIN,BACKUP_ADMIN, \
    BINLOG_ADMIN,BINLOG_ENCRYPTION_ADMIN,CLONE_ADMIN, \
    CONNECTION_ADMIN,ENCRYPTION_KEY_ADMIN,FIREWALL_EXEMPT, \
    FLUSH_OPTIMIZER_COSTS,FLUSH_PRIVILEGES,FLUSH_STATUS, \
    FLUSH_TABLES,FLUSH_USER_RESOURCES, \
    GROUP_REPLICATION_ADMIN,GROUP_REPLICATION_STREAM, \
    INNODB_REDO_LOG_ARCHIVE,INNODB_REDO_LOG_ENABLE, \
    OPTIMIZE_LOCAL_TABLE,PASSWORDLESS_USER_ADMIN, \
    PERSIST_RO_VARIABLES_ADMIN,REPLICATION_APPLIER, \
    REPLICATION_SLAVE_ADMIN,RESOURCE_GROUP_ADMIN, \
    RESOURCE_GROUP_USER,ROLE_ADMIN, \
    SENSITIVE_VARIABLES_OBSERVER,SERVICE_CONNECTION_ADMIN, \
