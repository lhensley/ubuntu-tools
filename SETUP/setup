rm -fr "$REPO_DIR" &>> $DETAIL_LOG
curl -L -s -o "$REPO_DIR.zip" \
  -O https://github.com/lhensley/ubuntu-tools/archive/master.zip &>> $DETAIL_LOG
unzip -q -d "$REPO_PARENT" "$REPO_DIR.zip" &>> $DETAIL_LOG
mv "$REPO_DIR-master" "$REPO_DIR" &>> $DETAIL_LOG
