    SYSTEM_USER,SYSTEM_VARIABLES_ADMIN, \
    TABLE_ENCRYPTION_ADMIN,TELEMETRY_LOG_ADMIN, \
    TRANSACTION_GTID_TAG,XA_RECOVER_ADMIN ON *.*  \
    TO `admin`@`localhost` WITH GRANT OPTION;"
mysql -e "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, \
    RELOAD, SHUTDOWN, PROCESS, FILE, REFERENCES, INDEX, \
