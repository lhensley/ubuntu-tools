mkdir -p "$SBIN_DIR" &>> $DETAIL_LOG              # Make $SBIN_DIR
chmod 755 "$SBIN_DIR" &>> $DETAIL_LOG             # Set permissions
rm -rf "$SBIN_DIR"/* &>> $DETAIL_LOG              # Make sure this directory are empty.
cp -r "$REPO_DIR/sbin" "$SBIN_PARENT/" &>> $DETAIL_LOG

f_record_to_installation_log "initialized and populating $SBIN_DIR"


#####################################################################################################
# RELOADING DAEMONS
