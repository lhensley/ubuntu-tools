#####################################################################################################
# INSTALL MySQL
#####################################################################################################

echo -e "\n\033[1;34m$0, line ${LINENO}, $(date +"%F %T.%3N %Z")\033[0m:" \
    "Installing MySQL." | tee -a "$DETAIL_LOG"

# Install the package
export DEBIAN_FRONTEND=noninteractive
# apt purge --yes mysql-server
apt install --yes mysql-server &>> $DETAIL_LOG
# Harden the installation
mysql -e "DELETE FROM mysql.user WHERE User='';" &>> $DETAIL_LOG # Delete anonymous users
mysql -e "DELETE FROM mysql.user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');" \
    &>> $DETAIL_LOG # Ensure the root user can not log in remotely
mysql -e "DROP DATABASE IF EXISTS test; DELETE FROM mysql.db WHERE Db='test' OR Db='test\_%';" \
    &>> $DETAIL_LOG # Remove the test database
mysql -e "FLUSH PRIVILEGES;"  &>> $DETAIL_LOG # Flush the privileges tables
# Open the eligible client addresses
sed -i 's/127.0.0.1/0.0.0.0/g' /etc/mysql/mysql.conf.d/mysqld.cnf &>> $DETAIL_LOG
# Set security
mysql -e "CREATE USER `admin`@`localhost` IDENTIFIED BY '$MYSQL_ADMIN_PWD';" \
    &>> $DETAIL_LOG
mysql -e "CREATE USER `admin`@`192.168.168.0/24` IDENTIFIED BY \"$MYSQL_ADMIN_PWD';" \
    &>> $DETAIL_LOG
mysql -e "CREATE USER `admin`@`10.0.0.0/8` IDENTIFIED BY \"$MYSQL_ADMIN_PWD\';" &>> $DETAIL_LOG
mysql -e "CREATE USER `lhensley`@`%` IDENTIFIED BY \"$MYSQL_LHENSLEY_PWD\';" &>> $DETAIL_LOG
mysql -e "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, \
    RELOAD, SHUTDOWN, PROCESS, FILE, REFERENCES, INDEX, \
    ALTER, SHOW DATABASES, SUPER, CREATE TEMPORARY TABLES, \
    LOCK TABLES, EXECUTE, REPLICATION SLAVE, \
    REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, \
    CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, \
    TRIGGER, CREATE TABLESPACE, CREATE ROLE, \
    DROP ROLE ON *.* TO `admin`@`localhost` WITH GRANT OPTION;" &>> $DETAIL_LOG
mysql -e "GRANT ALLOW_NONEXISTENT_DEFINER, \
    APPLICATION_PASSWORD_ADMIN,AUDIT_ABORT_EXEMPT, \
    AUDIT_ADMIN,AUTHENTICATION_POLICY_ADMIN,BACKUP_ADMIN, \
    BINLOG_ADMIN,BINLOG_ENCRYPTION_ADMIN,CLONE_ADMIN, \
    CONNECTION_ADMIN,ENCRYPTION_KEY_ADMIN,FIREWALL_EXEMPT, \
    FLUSH_OPTIMIZER_COSTS,FLUSH_PRIVILEGES,FLUSH_STATUS, \
    FLUSH_TABLES,FLUSH_USER_RESOURCES, \
    GROUP_REPLICATION_ADMIN,GROUP_REPLICATION_STREAM, \
    INNODB_REDO_LOG_ARCHIVE,INNODB_REDO_LOG_ENABLE, \
    OPTIMIZE_LOCAL_TABLE,PASSWORDLESS_USER_ADMIN, \
    PERSIST_RO_VARIABLES_ADMIN,REPLICATION_APPLIER, \
    REPLICATION_SLAVE_ADMIN,RESOURCE_GROUP_ADMIN, \
    RESOURCE_GROUP_USER,ROLE_ADMIN, \
    SENSITIVE_VARIABLES_OBSERVER,SERVICE_CONNECTION_ADMIN, \
    SESSION_VARIABLES_ADMIN,SET_ANY_DEFINER,SHOW_ROUTINE, \
    SYSTEM_USER,SYSTEM_VARIABLES_ADMIN, \
    TABLE_ENCRYPTION_ADMIN,TELEMETRY_LOG_ADMIN, \
    TRANSACTION_GTID_TAG,XA_RECOVER_ADMIN ON *.*  \
    TO `admin`@`localhost` WITH GRANT OPTION;" &>> $DETAIL_LOG
mysql -e "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, \
    RELOAD, SHUTDOWN, PROCESS, FILE, REFERENCES, INDEX, \
    ALTER, SHOW DATABASES, SUPER, CREATE TEMPORARY TABLES, \
